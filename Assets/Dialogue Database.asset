        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: Thank you!
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 

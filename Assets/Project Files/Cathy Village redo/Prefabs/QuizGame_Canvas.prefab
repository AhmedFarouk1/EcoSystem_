  quiz1Questions:
  - questionText: What's your ideal way to relax?
    choices:
    - A. Move my body
    - B. Be still and quiet
    - C. Hang out with someone
    choiceTypes:
    - A
    - B
    - C
  - questionText: How long do you have to relax?
    choices:
    - A. Less than 10 minutes
    - B. 30 minutes
    - C. A full day
    choiceTypes:
    - A
    - B
    - C
  - questionText: Where do you feel happiest?
    choices:
    - A. Outdoors
    - B. Home in my cozy space
    - 'C. Anywhere with company '
    choiceTypes:
    - A
    - B
    - C
  - questionText: How much energy do you have right now?
    choices:
    - 'A. Lots! '
    - B. Medium
    - C. Low, just want to chill
    choiceTypes:
    - A
    - B
    - C
  - questionText: 'Pick your favorite thing: '
    choices:
    - A. Trees
    - B. Pillows
    - C. Food
    choiceTypes:
    - A
    - B
    - C
  storySettings:
  - Magical Forest
  - Pirate Island
  - Outer Space
  storyCharacters:
  - 'Brave Squirrel '
  - Clever Robot
  - Kind Knight
